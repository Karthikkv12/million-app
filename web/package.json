{
  "name": "optionflow-v1",
  "version": "1.8.4",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "rm -rf .next && next dev -p 3000",
    "dev:main": "next dev -p 3000",
    "dev:develop": "next dev -p 3000",
    "build": "next build --no-lint",
    "start": "next start -p 3000",
    "start:fresh": "next build --no-lint && next start -p 3000",
    "lint": "next lint",
    "gen:api": "openapi-typescript openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.575.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "openapi-typescript": "7.10.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
